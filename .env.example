# Garmin Connect -> Settings -> Personal API
# https://connect.garmin.com/app/settings/personalApiToken
# Shown once at creation; expires after the period you chose (max one year).
GARMIN_PERSONAL_API_KEY=replace-with-your-personal-api-key

# Required by garmin-personal-mcp in HTTP mode. Any secret you choose.
# Generate one with: openssl rand -hex 32
# Clients must send it as: Authorization: Bearer <token>
MCP_BEARER_TOKEN=replace-with-a-random-token
